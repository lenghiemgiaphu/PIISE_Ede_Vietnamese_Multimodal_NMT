def cao_cau_ede(url):
    print(f"[*] Đang cào dữ liệu từ: {url}")
    cau_list = []
    try:
        response = requests.get(url, timeout=10)
        response.encoding = 'utf-8'
        soup = BeautifulSoup(response.text, 'html.parser')
        
        paragraphs = soup.find_all('p')
        for p in paragraphs:
            text = p.get_text(strip=True)
            
            # Tách đoạn văn thành các câu riêng biệt dựa trên dấu chấm, chấm hỏi, chấm than
            cac_cau_don = re.split(r'(?<=[.!?])\s+', text)
            
            for cau in cac_cau_don:
                cau = cau.strip()
                # Lọc bỏ các câu quá ngắn (dưới 30 ký tự) hoặc chứa cụm từ rác
                if len(cau) > 30 and "Giấy phép báo" not in cau:
                    cau_list.append(cau)
                    
    except Exception as e:
        print(f"Lỗi khi cào link: {e}")
    return cau_list

file_out = "cau_tieng_ede_raw.csv"

print("🚀 BẮT ĐẦU CÀO CÁC CÂU TIẾNG Ê ĐÊ SẠCH...\n")

count = 0
with open(file_out, mode='w', newline='', encoding='utf-8-sig') as f:
    writer = csv.writer(f)
    writer.writerow(['id', 'text_ede'])
    
    for link in danh_sach_link:
        ds_cau = cao_cau_ede(link)
        for cau in ds_cau:
            if "Giấy phép" not in cau:
                count += 1
                writer.writerow([count, cau])

print(f"\n🎉 HOÀN THÀNH! Đã thu thập được {count} câu Tiếng Ê Đê SẠCH.")
print(f"📁 Tệp được lưu tại: {file_out}")